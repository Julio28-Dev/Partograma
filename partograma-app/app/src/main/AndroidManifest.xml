<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissoes de armazenamento identicas ao APK original (salvar/compartilhar a imagem
         do relatorio). INTERNET e nova nesta etapa: o app original nao tinha, mas ela e
         estritamente necessaria para o cadastro de pacientes em nuvem (Firestore) pedido
         nesta evolucao. Sem ela nenhuma chamada de rede sai do aparelho. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PartogramaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SplashActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HomeActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".TelaInicial"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".PacientesActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".AdicionarPacienteActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".PacienteDetalhesActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".Menu"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".Detalhes"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".relatorio"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:exported="false" />

        <receiver
            android:name=".notifications.MyNotificationPublisher"
            android:exported="false" />

    </application>

</manifest>
