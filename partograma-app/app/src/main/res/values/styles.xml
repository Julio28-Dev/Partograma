<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppTheme original: Theme.AppCompat.Light.DarkActionBar (com.android.support 26.1.0).
         Migrado 1:1 para o equivalente AndroidX, sem qualquer alteracao de cores,
         atributos ou heranca. Ver REVERSE_ENGINEERING.md secao 4 (tecnologia). -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorHint">@color/textSecondary</item>
        <item name="buttonStyle">@style/AppTheme.Button</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Botao padrao das telas existentes (Menu/Detalhes/relatorio/TelaInicial): mesma
         identidade da Home (cor de destaque = colorAccent, ja realinhado a paleta nova),
         sem alterar nenhum id, texto ou comportamento de clique. -->
    <style name="AppTheme.Button" parent="Widget.AppCompat.Button.Colored">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Usado apenas pelas novas telas Splash/Home: layout full-bleed, sem ActionBar,
         para reproduzir a composicao da referencia visual (ver /refe.jpg). As demais
         telas do app permanecem com o AppTheme original, sem nenhuma alteracao. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Rotulo e campo de texto reutilizados no formulario de cadastro de paciente
         (AdicionarPacienteActivity), seguindo a mesma linguagem visual da Home/Pacientes. -->
    <style name="CampoLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CampoInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
