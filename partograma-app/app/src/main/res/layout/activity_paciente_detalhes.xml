<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back_thin" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeCabecalho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Ana Clara Souza"
                xmlns:tools="http://schemas.android.com/tools" />

            <TextView
                android:id="@+id/txtSubtituloCabecalho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="12.5sp"
                tools:text="Prontuário: 45872  •  28 anos"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnMenuPaciente"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/excluir_paciente_menu" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <include android:id="@+id/tabDados" layout="@layout/item_aba_detalhes" />
        <include android:id="@+id/tabPartograma" layout="@layout/item_aba_detalhes" />
        <include android:id="@+id/tabRelatorio" layout="@layout/item_aba_detalhes" />
        <include android:id="@+id/tabSinaisVitais" layout="@layout/item_aba_detalhes" />
        <include android:id="@+id/tabDesfecho" layout="@layout/item_aba_detalhes" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/conteudoDados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/paciente_dados_secao_principal"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerDadosPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_surface"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="14dp"
                    android:text="@string/paciente_dados_secao_evolucao"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerEvolucao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_surface"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/conteudoPartograma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="72dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="@string/partograma_titulo"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_surface"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <include android:id="@+id/indicadorDilatacao" layout="@layout/item_indicador_partograma" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />

                        <include android:id="@+id/indicadorRotatividade" layout="@layout/item_indicador_partograma" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtHoraUltimaAvaliacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card_surface"
                        android:elevation="2dp"
                        android:padding="16dp"
                        android:textColor="@color/textPrimary"
                        android:textSize="13.5sp"
                        tools:text="Hora da última avaliação\n09:20"
                        xmlns:tools="http://schemas.android.com/tools" />

                    <LinearLayout
                        android:id="@+id/btnVerGraficoCompleto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_button_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/partograma_ver_grafico"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/partograma_historico"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerHistorico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_surface"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="16dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnNovaAvaliacao"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_fab_primary"
                    android:contentDescription="@string/nova_avaliacao_titulo"
                    android:elevation="6dp"
                    android:padding="16dp"
                    android:src="@drawable/ic_add" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/conteudoRelatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/relatorio_titulo"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <include android:id="@+id/itemRelatorioEvolucao" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioGraficos" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioIntercorrencias" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioMedicacoes" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioObservacoes" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioSinaisVitais" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioDesfecho" layout="@layout/item_relatorio_row" />

                <LinearLayout
                    android:id="@+id/btnGerarPdf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/relatorio_gerar_pdf"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/conteudoSinaisVitais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="72dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="@string/sinais_vitais_historico"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerHistoricoSinaisVitais"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_surface"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="16dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnNovaAfericao"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_fab_primary"
                    android:contentDescription="@string/sinais_vitais_nova_afericao"
                    android:elevation="6dp"
                    android:padding="16dp"
                    android:src="@drawable/ic_add" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/conteudoDesfecho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/containerDesfechoRegistrado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_surface"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/desfecho_via_parto"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnViaVaginal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_segment_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/desfecho_via_vaginal"
                        android:textColor="@color/primaryPink"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnViaCesarea"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/desfecho_via_cesarea"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/desfecho_secao_informacoes"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_data_parto" />
                <EditText android:id="@+id/edtDataParto" style="@style/CampoInput" android:hint="dd/mm/aaaa" android:inputType="date" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_apresentacao_fetal" />
                <EditText android:id="@+id/edtApresentacaoFetal" style="@style/CampoInput" android:inputType="text" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_posicao_variedade" />
                <EditText android:id="@+id/edtPosicaoVariedade" style="@style/CampoInput" android:inputType="text" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_laceracao_perineal" />
                <Spinner android:id="@+id/spinnerLaceracaoPerineal" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:spinnerMode="dropdown" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_dequitacao" />
                <Spinner android:id="@+id/spinnerDequitacao" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:spinnerMode="dropdown" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_placenta" />
                <Spinner android:id="@+id/spinnerPlacenta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:spinnerMode="dropdown" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_intercorrencias" />
                <EditText android:id="@+id/edtIntercorrenciasParto" style="@style/CampoInput" android:inputType="textMultiLine" android:minLines="2" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_observacoes" />
                <EditText android:id="@+id/edtObservacoesParto" style="@style/CampoInput" android:inputType="textMultiLine" android:minLines="2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/desfecho_secao_rn"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_sexo" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:orientation="horizontal">
                    <TextView android:id="@+id/btnSexoMasculino" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_segment_selected" android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_sexo_masculino" android:textColor="@color/primaryPink" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnSexoFeminino" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_segment_unselected" android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_sexo_feminino" android:textColor="@color/textSecondary" android:textSize="13sp" />
                </LinearLayout>

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_peso" />
                <EditText android:id="@+id/edtPesoRn" style="@style/CampoInput" android:inputType="number" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_comprimento" />
                <EditText android:id="@+id/edtComprimentoRn" style="@style/CampoInput" android:inputType="numberDecimal" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_perimetro_cefalico" />
                <EditText android:id="@+id/edtPerimetroCefalico" style="@style/CampoInput" android:inputType="numberDecimal" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_horario_nascimento" />
                <EditText android:id="@+id/edtHorarioNascimento" style="@style/CampoInput" android:hint="HH:mm" android:inputType="datetime" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_apgar1" />
                <EditText android:id="@+id/edtApgar1" style="@style/CampoInput" android:inputType="number" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_apgar5" />
                <EditText android:id="@+id/edtApgar5" style="@style/CampoInput" android:inputType="number" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_apgar10" />
                <EditText android:id="@+id/edtApgar10" style="@style/CampoInput" android:inputType="number" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_contato_pele" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:orientation="horizontal">
                    <TextView android:id="@+id/btnContatoPeleSim" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_segment_selected" android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_sim" android:textColor="@color/primaryPink" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnContatoPeleNao" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_segment_unselected" android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_nao" android:textColor="@color/textSecondary" android:textSize="13sp" />
                </LinearLayout>

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_amamentacao" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:orientation="horizontal">
                    <TextView android:id="@+id/btnAmamentacaoSim" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_segment_selected" android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_sim" android:textColor="@color/primaryPink" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnAmamentacaoNao" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_segment_unselected" android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_nao" android:textColor="@color/textSecondary" android:textSize="13sp" />
                </LinearLayout>

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_intercorrencias_rn" />
                <EditText android:id="@+id/edtIntercorrenciasRn" style="@style/CampoInput" android:inputType="text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/desfecho_secao_encerramento"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_condicao_materna" />
                <EditText android:id="@+id/edtCondicaoMaterna" style="@style/CampoInput" android:inputType="text" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_condicao_rn" />
                <EditText android:id="@+id/edtCondicaoRn" style="@style/CampoInput" android:inputType="text" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_destino_puerpera" />
                <EditText android:id="@+id/edtDestinoPuerpera" style="@style/CampoInput" android:inputType="text" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_destino_rn" />
                <EditText android:id="@+id/edtDestinoRn" style="@style/CampoInput" android:inputType="text" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_profissional" />
                <EditText android:id="@+id/edtProfissionalDesfecho" style="@style/CampoInput" android:inputType="textPersonName|textCapWords" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_coren" />
                <EditText android:id="@+id/edtCorenDesfecho" style="@style/CampoInput" android:inputType="text" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_observacoes_finais" />
                <EditText android:id="@+id/edtObservacoesFinais" style="@style/CampoInput" android:inputType="textMultiLine" android:minLines="2" />

                <LinearLayout
                    android:id="@+id/btnSalvarDesfecho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/desfecho_salvar"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressDesfecho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/primaryPink"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressDetalhes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primaryPink" />
        </FrameLayout>
    </ScrollView>
</LinearLayout>
