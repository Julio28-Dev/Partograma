                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_sexo_feminino" android:textColor="@color/textSecondary" android:textSize="13sp" />
                </LinearLayout>

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_peso" />
