                    <TextView android:id="@+id/btnAmamentacaoNao" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_segment_unselected" android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_nao" android:textColor="@color/textSecondary" android:textSize="13sp" />
                </LinearLayout>

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_intercorrencias_rn" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/btnIntercorrenciaRnSim" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp"
