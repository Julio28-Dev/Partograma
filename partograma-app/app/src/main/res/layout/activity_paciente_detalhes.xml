<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back_thin" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/paciente_detalhes_titulo_registro"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnMenuPaciente"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/excluir_paciente_menu" />
    </LinearLayout>

    <LinearLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_surface"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_avatar_circle">

                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_avatar_gestante"
                    app:tint="@color/primaryPink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNomeCabecalho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Ana Clara Souza" />

                <TextView
                    android:id="@+id/txtSubtituloCabecalho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    tools:text="Prontuário: 45872  •  28 anos" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtStatusCabecalho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_teal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/softTeal"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Em avaliação" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@color/border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paciente_detalhes_metrica_ultima_data"
                    android:textColor="@color/textSecondary"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/txtUltimaDataCabecalho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="05/06, 07:40" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paciente_detalhes_metrica_hora_registro"
                    android:textColor="@color/textSecondary"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/txtHoraRegistroCabecalho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="07:40" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/paciente_detalhes_metrica_ig"
                    android:textColor="@color/textSecondary"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/txtIgCabecalho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="39s + 2d" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <include android:id="@+id/tabDados" layout="@layout/item_aba_detalhes" />
        <include android:id="@+id/tabSinaisVitais" layout="@layout/item_aba_detalhes" />
        <include android:id="@+id/tabPartograma" layout="@layout/item_aba_detalhes" />
        <include android:id="@+id/tabRelatorio" layout="@layout/item_aba_detalhes" />
        <include android:id="@+id/tabDesfecho" layout="@layout/item_aba_detalhes" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/conteudoDados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/paciente_dados_secao_principal"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerDadosPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_surface"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="14dp"
                    android:text="@string/paciente_dados_secao_evolucao"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerEvolucao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_surface"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/conteudoPartograma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="72dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:text="@string/partograma_titulo"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_surface"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <include android:id="@+id/indicadorDilatacao" layout="@layout/item_indicador_partograma" />

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />

                        <include android:id="@+id/indicadorRotatividade" layout="@layout/item_indicador_partograma" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtHoraUltimaAvaliacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card_surface"
                        android:elevation="2dp"
                        android:padding="16dp"
                        android:textColor="@color/textPrimary"
                        android:textSize="13.5sp"
                        tools:text="Hora da última avaliação\n09:20"
                        xmlns:tools="http://schemas.android.com/tools" />

                    <LinearLayout
                        android:id="@+id/btnVerGraficoCompleto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_button_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="13dp"
                        android:paddingBottom="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/partograma_ver_grafico"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/partograma_historico"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerHistorico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_surface"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="16dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnNovaAvaliacao"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_fab_primary"
                    android:contentDescription="@string/nova_avaliacao_titulo"
                    android:elevation="6dp"
                    android:padding="16dp"
                    android:src="@drawable/ic_add" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/conteudoRelatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/relatorio_titulo"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <include android:id="@+id/itemRelatorioEvolucao" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioGraficos" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioIntercorrencias" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioMedicacoes" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioObservacoes" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioSinaisVitais" layout="@layout/item_relatorio_row" />
                <include android:id="@+id/itemRelatorioDesfecho" layout="@layout/item_relatorio_row" />

                <LinearLayout
                    android:id="@+id/btnGerarPdf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/relatorio_gerar_pdf"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                xmlns:tools="http://schemas.android.com/tools"
                android:id="@+id/conteudoSinaisVitais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnNovaAfericao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_add" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/sinais_vitais_nova_afericao"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sinais_vitais_historico"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtContagemSinaisVitais"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_teal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/softTeal"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        tools:text="5" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerHistoricoSinaisVitais"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/conteudoDesfecho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/containerDesfechoRegistrado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_surface"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_card_surface"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/bg_avatar_circle" android:gravity="center" android:text="1" android:textColor="@color/primaryPink" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/desfecho_via_parto" android:textColor="@color/textPrimary" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnViaVaginal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_segment_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/desfecho_via_vaginal"
                            android:textColor="@color/primaryPink"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnViaCesarea"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment_unselected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:text="@string/desfecho_via_cesarea"
                            android:textColor="@color/textSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_card_surface"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/bg_avatar_circle" android:gravity="center" android:text="2" android:textColor="@color/primaryPink" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/desfecho_secao_informacoes" android:textColor="@color/textPrimary" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_data_parto" />
                <EditText android:id="@+id/edtDataParto" style="@style/CampoInput" android:hint="dd/mm/aaaa" android:inputType="number" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_apresentacao_fetal" />
                <Spinner android:id="@+id/spinnerApresentacaoFetal" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:spinnerMode="dropdown" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_posicao_variedade" />
                <Spinner android:id="@+id/spinnerPosicaoVariedade" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:spinnerMode="dropdown" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_laceracao_perineal" />
                <Spinner android:id="@+id/spinnerLaceracaoPerineal" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:spinnerMode="dropdown" />

                <LinearLayout
                    android:id="@+id/containerObservacoesLaceracao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/CampoLabel" android:text="@string/desfecho_observacoes_laceracao" />
                    <EditText android:id="@+id/edtObservacoesLaceracao" style="@style/CampoInput" android:inputType="textMultiLine" android:minLines="2" />
                </LinearLayout>

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_dequitacao" />
                <Spinner android:id="@+id/spinnerDequitacao" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:spinnerMode="dropdown" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_placenta" />
                <Spinner android:id="@+id/spinnerPlacenta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp" android:background="@drawable/bg_input_field"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:spinnerMode="dropdown" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_intercorrencias" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:orientation="horizontal">
                    <TextView android:id="@+id/btnIntercorrenciaMaeSim" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_segment_unselected" android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_sim" android:textColor="@color/textSecondary" android:textSize="13sp" />
                    <TextView android:id="@+id/btnIntercorrenciaMaeNao" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_segment_selected" android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_nao" android:textColor="@color/primaryPink" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerDescricaoIntercorrenciaMae"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView style="@style/CampoLabel" android:text="@string/nova_avaliacao_descricao_intercorrencia" />
                    <EditText android:id="@+id/edtDescricaoIntercorrenciaMae" style="@style/CampoInput" android:inputType="textMultiLine" android:minLines="2" />
                </LinearLayout>

                    <TextView style="@style/CampoLabel" android:text="@string/desfecho_observacoes" />
                    <EditText android:id="@+id/edtObservacoesParto" style="@style/CampoInput" android:layout_marginBottom="0dp" android:inputType="textMultiLine" android:minLines="2" />
