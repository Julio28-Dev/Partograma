                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_sim" android:textColor="@color/primaryPink" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnContatoPeleNao" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_segment_unselected" android:clickable="true" android:focusable="true" android:gravity="center"
                        android:paddingTop="10dp" android:paddingBottom="10dp" android:text="@string/desfecho_nao" android:textColor="@color/textSecondary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerMotivoSemContatoPele"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
