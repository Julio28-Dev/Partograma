                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/desfecho_secao_rn" android:textColor="@color/textPrimary" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_sexo" />
