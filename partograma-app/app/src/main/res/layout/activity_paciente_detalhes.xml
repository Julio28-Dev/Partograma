                <TextView style="@style/CampoLabel" android:text="@string/desfecho_profissional" />
                <EditText android:id="@+id/edtProfissionalDesfecho" style="@style/CampoInput" android:inputType="textPersonName|textCapWords" />

                <TextView style="@style/CampoLabel" android:text="@string/desfecho_coren" />
                <EditText android:id="@+id/edtCorenDesfecho" style="@style/CampoInput" android:inputType="text" />

                    <TextView style="@style/CampoLabel" android:text="@string/desfecho_observacoes_finais" />
                    <EditText android:id="@+id/edtObservacoesFinais" style="@style/CampoInput" android:layout_marginBottom="0dp" android:inputType="textMultiLine" android:minLines="2" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSalvarDesfecho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_save" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/desfecho_salvar"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressDesfecho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/primaryPink"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressDetalhes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primaryPink" />
        </FrameLayout>
    </ScrollView>
</LinearLayout>
