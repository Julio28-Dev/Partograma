<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back_thin" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/adicionar_paciente_titulo"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_nome" />
            <EditText
                android:id="@+id/edtNome"
                style="@style/CampoInput"
                android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_prontuario" />
            <EditText
                android:id="@+id/edtProntuario"
                style="@style/CampoInput"
                android:inputType="text" />

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_nascimento" />
            <EditText
                android:id="@+id/edtDataNascimento"
                style="@style/CampoInput"
                android:hint="dd/mm/aaaa"
                android:inputType="date" />

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_dum" />
            <EditText
                android:id="@+id/edtDum"
                style="@style/CampoInput"
                android:hint="dd/mm/aaaa"
                android:inputType="date" />

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_tipo_sanguineo" />
            <Spinner
                android:id="@+id/spinnerTipoSanguineo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:spinnerMode="dropdown" />

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_alergias" />
            <EditText
                android:id="@+id/edtAlergias"
                style="@style/CampoInput"
                android:hint="Nega"
                android:inputType="text" />

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_comorbidades" />
            <LinearLayout
                android:id="@+id/containerComorbidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/edtComorbidadesOutras"
                style="@style/CampoInput"
                android:layout_marginBottom="14dp"
                android:hint="@string/adicionar_paciente_comorbidades_outras"
                android:inputType="text"
                android:visibility="gone" />

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_classificacao_risco" />
            <Spinner
                android:id="@+id/spinnerClassificacaoRisco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:spinnerMode="dropdown" />

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_profissional" />
            <EditText
                android:id="@+id/edtProfissional"
                style="@style/CampoInput"
                android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_queixa" />
            <EditText
                android:id="@+id/edtQueixa"
                style="@style/CampoInput"
                android:inputType="textMultiLine"
                android:minLines="2" />

            <TextView style="@style/CampoLabel" android:text="@string/adicionar_paciente_conduta" />
            <EditText
                android:id="@+id/edtConduta"
                style="@style/CampoInput"
                android:inputType="textMultiLine"
                android:minLines="2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCancelar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:text="@string/adicionar_paciente_cancelar"
                    android:textColor="@color/textSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSalvar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:text="@string/adicionar_paciente_salvar"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressSalvando"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/primaryPink"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
