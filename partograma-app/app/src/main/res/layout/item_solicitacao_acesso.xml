<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_surface"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/txtNomeInstituicaoSolicitacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Maternidade Santa Clara" />

    <TextView
        android:id="@+id/txtResponsavelSolicitacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/textSecondary"
        android:textSize="12.5sp"
        tools:text="Responsável: Ana Souza" />

    <TextView
        android:id="@+id/txtEmailSolicitacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/textSecondary"
        android:textSize="12.5sp"
        tools:text="ana.souza@maternidade.com" />

    <TextView
        android:id="@+id/txtTelefoneSolicitacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/textSecondary"
        android:textSize="12.5sp"
        tools:text="(11) 99999-9999" />

    <TextView
        android:id="@+id/txtDataSolicitacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/textSecondary"
        android:textSize="11.5sp"
        tools:text="Solicitado em 29/09/2026" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRejeitarSolicitacao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="@string/autorizacoes_rejeitar"
            android:textColor="@color/textSecondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAceitarSolicitacao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="@string/autorizacoes_aceitar"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
