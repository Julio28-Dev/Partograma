<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back_thin" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sinais_vitais_nova_afericao"
                android:textColor="@color/textPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/nova_afericao_subtitulo"
                android:textColor="@color/textSecondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_feature_pulse" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_surface"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_avatar_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_patient" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNomePacienteAfericao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/textPrimary"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSubtituloPacienteAfericao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_surface"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_vital_calendar" />
                        <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="6dp" android:text="@string/sinais_vitais_data_afericao" />
                    </LinearLayout>
                    <EditText android:id="@+id/edtDataAfericao" style="@style/CampoInput" android:layout_marginTop="8dp" android:layout_marginBottom="0dp" android:hint="dd/mm/aaaa" android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_feature_clock" />
                        <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="6dp" android:text="@string/sinais_vitais_horario" />
                    </LinearLayout>
                    <EditText android:id="@+id/edtHorarioAfericao" style="@style/CampoInput" android:layout_marginTop="8dp" android:layout_marginBottom="0dp" android:hint="HH:mm" android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_surface"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_avatar_circle">
                        <ImageView android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_vital_stethoscope" />
                    </FrameLayout>
                    <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="10dp" android:text="@string/sinais_vitais_pa" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/edtPaSistolica" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_input_field" android:textColor="@color/textPrimary" android:textColorHint="@color/textSecondary" android:textSize="14sp" android:inputType="number" android:hint="Sistólica" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="×" android:textColor="@color/textSecondary" />
                    <EditText android:id="@+id/edtPaDiastolica" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_input_field" android:textColor="@color/textPrimary" android:textColorHint="@color/textSecondary" android:textSize="14sp" android:inputType="number" android:hint="Diastólica" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="mmHg" android:textColor="@color/textSecondary" android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_avatar_circle">
                        <ImageView android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_feature_pulse" />
                    </FrameLayout>
                    <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="10dp" android:text="@string/sinais_vitais_fc" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/edtFrequenciaCardiaca" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_input_field" android:textColor="@color/textPrimary" android:textSize="14sp" android:inputType="number" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="bpm" android:textColor="@color/textSecondary" android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_avatar_circle">
                        <ImageView android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_vital_lungs" />
                    </FrameLayout>
                    <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="10dp" android:text="@string/sinais_vitais_fr" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/edtFrequenciaRespiratoria" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_input_field" android:textColor="@color/textPrimary" android:textSize="14sp" android:inputType="number" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="irpm" android:textColor="@color/textSecondary" android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_avatar_circle">
                        <ImageView android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_vital_thermometer" />
                    </FrameLayout>
                    <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="10dp" android:text="@string/sinais_vitais_temperatura" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/edtTemperatura" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_input_field" android:textColor="@color/textPrimary" android:textSize="14sp" android:inputType="numberDecimal" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="°C" android:textColor="@color/textSecondary" android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_avatar_circle">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_vital_drop" app:tint="@color/softTeal" />
                    </FrameLayout>
                    <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="10dp" android:text="@string/sinais_vitais_spo2" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/edtSpo2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_input_field" android:textColor="@color/textPrimary" android:textSize="14sp" android:inputType="number" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="%" android:textColor="@color/textSecondary" android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_avatar_circle">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_vital_drop" app:tint="@color/primaryPink" />
                    </FrameLayout>
                    <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="10dp" android:text="@string/sinais_vitais_dor" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/edtDor" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_input_field" android:textColor="@color/textPrimary" android:textSize="14sp" android:inputType="number" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="/10" android:textColor="@color/textSecondary" android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_avatar_circle">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_vital_drop" app:tint="@color/softPurple" />
                    </FrameLayout>
                    <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="10dp" android:text="@string/sinais_vitais_hgt" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/edtHgt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/bg_input_field" android:textColor="@color/textPrimary" android:textSize="14sp" android:inputType="numberDecimal" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="mg/dL" android:textColor="@color/textSecondary" android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card_surface"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp" android:importantForAccessibility="no" android:src="@drawable/ic_vital_notes" />
                    <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="8dp" android:text="@string/sinais_vitais_observacoes" />
                </LinearLayout>
                <EditText android:id="@+id/edtObservacoesAfericao" style="@style/CampoInput" android:layout_marginTop="8dp" android:layout_marginBottom="0dp" android:inputType="textMultiLine" android:minLines="2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_surface"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp" android:importantForAccessibility="no" android:src="@drawable/ic_patient" />
                    <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" android:layout_marginStart="8dp" android:text="@string/sinais_vitais_examinador" />
                </LinearLayout>
                <EditText android:id="@+id/edtExaminadorAfericao" style="@style/CampoInput" android:layout_marginTop="8dp" android:layout_marginBottom="0dp" android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCancelarAfericao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:text="@string/sinais_vitais_cancelar"
                    android:textColor="@color/textSecondary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btnSalvarAfericao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_save" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/sinais_vitais_salvar"
                        android:textColor="#FFFFFFFF"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressAfericao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/primaryPink"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
