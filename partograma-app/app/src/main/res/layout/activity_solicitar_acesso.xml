<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob_top_left" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_blob_bottom_right" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/btnVoltarSolicitarAcesso"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_back_thin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/solicitar_acesso_titulo"
                android:textColor="@color/textPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/solicitar_acesso_subtitulo"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/containerFormulario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_surface"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView style="@style/CampoLabel" android:layout_marginTop="0dp" android:text="@string/solicitar_acesso_nome_instituicao" />
                <EditText
                    android:id="@+id/edtNomeInstituicao"
                    style="@style/CampoInput"
                    android:inputType="textCapWords"
                    android:maxLines="1" />

                <TextView style="@style/CampoLabel" android:text="@string/solicitar_acesso_responsavel" />
                <EditText
                    android:id="@+id/edtResponsavel"
                    style="@style/CampoInput"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1" />

                <TextView style="@style/CampoLabel" android:text="@string/solicitar_acesso_email" />
                <EditText
                    android:id="@+id/edtEmailSolicitacao"
                    style="@style/CampoInput"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />

                <TextView style="@style/CampoLabel" android:text="@string/solicitar_acesso_telefone" />
                <EditText
                    android:id="@+id/edtTelefoneSolicitacao"
                    style="@style/CampoInput"
                    android:inputType="phone"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/txtErroSolicitarAcesso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:textColor="@color/colorAlerta"
                    android:textSize="12.5sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/btnEnviarSolicitacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/solicitar_acesso_enviar"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressSolicitarAcesso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:indeterminateTint="@color/primaryPink"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/solicitar_acesso_rodape"
                android:textColor="@color/textSecondary"
                android:textSize="11.5sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
