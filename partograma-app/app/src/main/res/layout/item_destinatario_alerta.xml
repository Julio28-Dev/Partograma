<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_input_field"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNomeDestinatario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Dra. Fernanda Lima" />

        <TextView
            android:id="@+id/txtContatoDestinatario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            tools:text="fernanda.lima@hospital.com" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnRemoverDestinatario"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="7dp"
        android:src="@drawable/ic_delete"
        android:contentDescription="@string/alertas_remover_destinatario" />

</LinearLayout>
