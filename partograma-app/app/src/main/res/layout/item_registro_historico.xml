<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtHoraHistorico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textPrimary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="09:20" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_dot_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtDilatacaoHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textPrimary"
            android:textSize="13sp"
            tools:text="Dilatação: 7 cm" />

        <TextView
            android:id="@+id/txtRotatividadeHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            tools:text="Rotatividade: Posição 3" />
    </LinearLayout>

</LinearLayout>
