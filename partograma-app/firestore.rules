// Regras de seguranca do Firestore do projeto "Partograma Digital" (partograma-digital).
//
// Este arquivo NAO e aplicado automaticamente -- ele precisa ser colado manualmente no
// Firebase Console (Firestore Database -> Regras) ate existir um deploy automatizado
// (Firebase CLI) configurado para este projeto. Mantido aqui versionado para ficar
// documentado e revisavel junto com o resto do codigo.
//
// Substitui o "modo de teste" (liberado para qualquer um por 30 dias). A partir daqui,
// toda leitura/escrita exige que o app tenha autenticado o aparelho de forma anonima
// (ver PartogramaApplication.java) -- nao existe conceito de usuario/paciente "dono" do
// dado, porque o app original tambem nunca teve login: toda a equipe usa o mesmo
// aplicativo igualmente. Autenticacao anonima bloqueia scripts aleatorios na internet
// sem exigir nenhuma tela de login nova.
//
// Login institucional (LoginActivity, Firebase Auth email/senha): cada instituicao tem uma
// conta propria (criada manualmente no Firebase Console, sem tela de cadastro publico).
// Fazer login com e-mail/senha substitui a sessao anonima do aparelho -- "estaAutenticado()"
// continua valendo para os dois casos, entao "pacientes" (colecao antiga, sem conceito de
// instituicao) nao foi restringida por instituicao aqui: os poucos documentos ja existentes
// nao tem o campo "institutionId" e uma regra que exigisse esse campo bateria de frente com
// a limitacao do Firestore de nao conseguir filtrar consultas de lista parcialmente por
// regra (ou a consulta inteira e permitida, ou inteira negada) -- ou seja, teria feito os
// cadastros antigos desaparecerem da lista de Pacientes para todo mundo, o que o cliente
// pediu explicitamente para nao acontecer. Fica documentado como pendente: para isolamento
// completo entre instituicoes na colecao "pacientes", seria necessario decidir a quem
// atribuir os cadastros antigos (ou aceitar que continuem compartilhados) e so entao trocar
// a consulta do app para filtrar por institutionId com a regra correspondente.
//
// A colecao nova "instituicoes" (mensagem padrao de alerta, destinatarios, historico de
// alertas) e isolada de verdade desde o primeiro dia, sem esse problema de dado legado.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funcoes definidas AQUI DENTRO (nao no nivel de cima) de proposito: souAdmin() usa
    // $(database) dentro de exists(), e essa variavel so resolve de forma confiavel
    // quando a funcao esta no mesmo escopo do "match /databases/{database}/documents"
    // que a capturou. Definida no nivel de cima (fora deste match), exists() nao
    // enxergava o documento admins/{uid} direito -- souAdmin() sempre caia em falso
    // mesmo com o documento existindo, o que bloqueava o proprio admin de ler
    // institutionAccessRequests. Corrigido movendo as funcoes para ca.
    function estaAutenticado() {
      return request.auth != null;
    }

    function souAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Uma instituicao pode ser desativada pelo admin depois de ja ter feito login (campo
    // "ativo" em instituicoes/{uid}). Documento ainda inexistente (primeiro login logo
    // apos aprovacao) ou sem o campo "ativo" (contas antigas, de antes desse campo
    // existir) contam como ativa -- so um "ativo == false" explicito bloqueia.
    function instituicaoAtiva(institutionId) {
      return !exists(/databases/$(database)/documents/instituicoes/$(institutionId))
        || get(/databases/$(database)/documents/instituicoes/$(institutionId)).data.get('ativo', true) != false;
    }

    // A conta Firebase Auth de uma instituicao que pediu acesso pelo app existe DESDE A
    // SOLICITACAO (com a senha que ela mesma escolheu, ver SolicitacaoAcessoRepository),
    // antes de qualquer aprovacao -- ela ja consegue autenticar mesmo pendente/rejeitada.
    // Sem esta funcao, o dono (request.auth.uid == institutionId) poderia criar o proprio
    // instituicoes/{uid} diretamente (contornando o app) e se autoaprovar. O ID do
    // documento em institutionAccessRequests e sempre o mesmo uid da conta (ver
    // solicitarAcesso), entao da pra checar por get() direto sem precisar de query.
    // Contas criadas manualmente no Console (sem passar pelo fluxo de solicitacao, sem
    // documento correspondente aqui) continuam podendo se auto-provisionar como antes.
    function temSolicitacaoNaoAprovada(institutionId) {
      return exists(/databases/$(database)/documents/institutionAccessRequests/$(institutionId))
        && get(/databases/$(database)/documents/institutionAccessRequests/$(institutionId)).data.status != 'aprovada';
    }

    // Validacao minima: exige que os campos centrais existam e nao estejam vazios,
    // sem travar campos opcionais (alergias, tipo sanguineo, etc. podem ficar de fora).
    function dadosDoPacienteValidos(dados) {
      return dados.keys().hasAll(['nome', 'prontuario', 'dataNascimento'])
        && dados.nome is string && dados.nome.size() > 0
        && dados.prontuario is string && dados.prontuario.size() > 0
        && dados.dataNascimento is string && dados.dataNascimento.size() > 0;
    }

    match /pacientes/{pacienteId} {
      allow read, delete: if estaAutenticado();
      allow create: if estaAutenticado() && dadosDoPacienteValidos(request.resource.data);
      allow update: if estaAutenticado() && dadosDoPacienteValidos(request.resource.data);

      // Registros horarios do partograma (equivalente a "pessoa{slot}{campo}{hora}").
      match /registros/{registroId} {
        allow read, write: if estaAutenticado();
      }

      // Notas de evolucao da paciente (aba "Dados").
      match /evolucoes/{evolucaoId} {
        allow read, write: if estaAutenticado();
      }

      // Afericoes de sinais vitais (aba "Sinais vitais", independente do partograma).
      match /sinaisVitais/{sinalVitalId} {
        allow read, write: if estaAutenticado();
      }
    }

    // Dados da instituicao logada: mensagem padrao de alerta, destinatarios autorizados e
    // historico de alertas emitidos. institutionId e sempre o uid do Firebase Auth de quem
    // fez login (LoginActivity) -- por isso da para isolar de verdade aqui, diferente de
    // "pacientes" (ver comentario no topo do arquivo).
    match /instituicoes/{institutionId} {
      // CREATE: o dono so pode auto-criar o proprio documento se NAO existir nenhuma
      // solicitacao de acesso ainda-nao-aprovada com esse mesmo uid (ver
      // temSolicitacaoNaoAprovada) -- e o que impede alguem com pedido pendente ou
      // rejeitado de se autoaprovar direto no Firestore, contornando o admin.
      allow create: if estaAutenticado()
        && (souAdmin() || (request.auth.uid == institutionId && !temSolicitacaoNaoAprovada(institutionId)));

      // READ/UPDATE/DELETE: souAdmin() alem do dono porque o admin tambem precisa
      // conseguir gravar o documento ja aprovado (ver institutionAccessRequests abaixo).
      // instituicaoAtiva() bloqueia uma instituicao desativada pelo admin DEPOIS do
      // login de acessar os proprios dados, mesmo com o Firebase Auth ainda valido.
      allow read, update, delete: if estaAutenticado()
        && (souAdmin() || (request.auth.uid == institutionId && instituicaoAtiva(institutionId)));

      match /destinatarios/{destinatarioId} {
        allow read, write: if estaAutenticado()
          && (souAdmin() || (request.auth.uid == institutionId && instituicaoAtiva(institutionId)));
      }

      match /alertas/{alertaId} {
        allow read, write: if estaAutenticado()
          && (souAdmin() || (request.auth.uid == institutionId && instituicaoAtiva(institutionId)));
      }
    }

    // Marcador de administrador: a existencia do documento admins/{uid} e o unico
    // criterio que distingue um admin de uma instituicao comum (sem hardcode de
    // e-mail/senha/uid no APK). Ninguem pode se autopromover: "write" e sempre negado
    // pelo cliente -- o documento so e criado manualmente (Firebase Console/script
    // administrativo), nunca pelo proprio app. "get" so pode ler o proprio uid (o app
    // usa isso so para saber "eu sou admin?"); "list" fica bloqueado para nao expor
    // quem mais e admin.
    match /admins/{uid} {
      allow get: if estaAutenticado() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // Solicitacoes de acesso institucional (tela "Solicitar acesso" -> aprovacao do
    // admin em Configuracoes -> Autorizacoes). Qualquer usuario autenticado (inclusive
    // sessao anonima, ja que quem solicita ainda nao tem login institucional) pode
    // CRIAR uma solicitacao propria, sempre como "pendente" e sem poder se autoaprovar
    // (nao pode setar status diferente de pendente, nem revisadoPor, na criacao).
    // Ler/listar todas e mudar o status (aprovar/rejeitar) e privilegio exclusivo do
    // admin -- uma instituicao comum nao consegue listar, aprovar, rejeitar ou alterar
    // manualmente o proprio status.
    match /institutionAccessRequests/{requestId} {
      // O ID do documento (requestId) e sempre o uid da conta Firebase Auth da
      // instituicao, criada JA NA SOLICITACAO com a senha que ela mesma escolhe (ver
      // SolicitacaoAcessoRepository.solicitarAcesso) -- nao e um ID autogerado. Para nao
      // virar um jeito de "sequestrar" uma instituicao ja aprovada (reenviando uma
      // "solicitacao" com o mesmo uid de alguem que ja existe), so aceita se ainda NAO
      // existir instituicoes/{requestId} -- ou seja, so serve pra uma conta nova, nunca
      // aprovada.
      allow create: if estaAutenticado()
        && request.resource.data.status == 'pendente'
        && request.resource.data.keys().hasAll(['nomeInstituicao', 'responsavel', 'email', 'criadoEm'])
        && !('revisadoPor' in request.resource.data)
        && !exists(/databases/$(database)/documents/instituicoes/$(requestId));
      allow read: if souAdmin();
      allow update: if souAdmin();
      allow delete: if false;
    }

    // Qualquer outra colecao nao prevista acima fica bloqueada por padrao.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
